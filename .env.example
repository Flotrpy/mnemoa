# Copy to .env and adjust. Environment variables override .mnemoa.toml.

# Repository to mount into the container (mounted at /workspace/repo).
MNEMOA_WORKSPACE=.
MNEMOA_PORT=8080
MNEMOA_TARGETS=claude-code,codex,cursor
MNEMOA_MAX_LINES=200
MNEMOA_TOKEN_BUDGET=4000
MNEMOA_FOSSIL_COMMITS=25

# Allow `apply: true` over HTTP. Also remove `:ro` from the volume in docker-compose.yml.
MNEMOA_API_ALLOW_WRITE=false

# Optional LLM drafter for ast-grep rules.
MNEMOA_LLM_ENABLED=false
# ollama | openai | anthropic | custom
MNEMOA_LLM_PROVIDER=ollama
MNEMOA_LLM_BASE_URL=http://ollama:11434/v1
MNEMOA_LLM_MODEL=qwen2.5-coder:7b
MNEMOA_LLM_API_KEY=ollama

# OpenAI:
# MNEMOA_LLM_PROVIDER=openai
# MNEMOA_LLM_BASE_URL=https://api.openai.com/v1
# MNEMOA_LLM_MODEL=<model>
# MNEMOA_LLM_API_KEY=<key>

# Anthropic (base URL defaults to https://api.anthropic.com, model to claude-opus-5-5):
# MNEMOA_LLM_PROVIDER=anthropic
# MNEMOA_LLM_BASE_URL=https://api.anthropic.com
# MNEMOA_LLM_MODEL=claude-opus-5-5
# MNEMOA_LLM_API_KEY=<key>
